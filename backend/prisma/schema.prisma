generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int                     @id @default(autoincrement())
  username               String                  @unique
  email                  String                  @unique
  passwordHash           String
  role                   String                  @default("User")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  preferences            UserPreference[]
  library                UserLibrary[]
  achievements           UserAchievement[]
  discordRecommendations DiscordRecommendation[]
}

model Content {
  id                     Int                     @id @default(autoincrement())
  title                  String
  category               String // "Anime", "Manga", "Movie", "TV", "Game"
  description            String                  @db.NVarChar(MAX)
  discordLink            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  coverImage             String?                 @db.NVarChar(MAX)
  externalId             String?
  externalUrl            String?                 @db.NVarChar(MAX)
  rating                 Float?
  source                 String?
  status                 String?
  isSuggested            Boolean                 @default(false)
  tags                   ContentTag[]
  library                UserLibrary[]
  discordRecommendations DiscordRecommendation[]

  @@unique([source, externalId])
}

model Tag {
  id        Int          @id @default(autoincrement())
  type      String
  name      String
  createdAt DateTime     @default(now())
  contents  ContentTag[]

  @@unique([type, name])
}

model ContentTag {
  contentId Int
  tagId     Int
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
}

model UserPreference {
  userId             Int
  preferenceOptionId Int
  createdAt          DateTime         @default(now())
  PreferenceOption   PreferenceOption @relation(fields: [preferenceOptionId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, preferenceOptionId])
}

model PreferenceOption {
  id             Int              @id @default(autoincrement())
  type           String
  value          String
  createdAt      DateTime         @default(now())
  UserPreference UserPreference[]

  @@unique([type, value])
}

model UserLibrary {
  id        Int      @id @default(autoincrement())
  userId    Int
  contentId Int
  status    String // "PLANNING" (Watchlist), "COMPLETED", "CURRENT"
  rating    Int? // User's personal score (1-10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}

model UserAchievement {
  id         Int      @id @default(autoincrement())
  userId     Int
  key        String // e.g. "FIRST_COMPLETE", "ANIME_FAN_10"
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model DiscordRecommendation {
  id         Int      @id @default(autoincrement())
  userId     Int
  contentId  Int
  inviteLink String
  status     String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}
