generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int                     @id @default(autoincrement())
  username               String                  @unique
  email                  String                  @unique
  passwordHash           String
  role                   String                  @default("User")
  bio                    String?
  avatarUrl              String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  preferences            UserPreference[]
  library                UserLibrary[]
  activities             Activity[]
  following              Friendship[]            @relation("Follower")
  followedBy             Friendship[]            @relation("Following")
  achievements           UserAchievement[]
  discordRecommendations DiscordRecommendation[]
  events                 Event[]
  favourites               Favourite[]
  subredditRecommendations SubredditRecommendation[]
  reviews                Review[]
  activityReactions      ActivityReaction[]
  activityComments       ActivityComment[]
}

model Content {
  id                     Int                     @id @default(autoincrement())
  title                  String
  category               String
  description            String
  discordLink            String?
  redditLink             String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  coverImage             String?
  bannerImage            String?
  externalId             String?
  externalUrl            String?
  rating                 Float?
  source                 String?
  status                 String?
  totalEpisodes          Int?
  totalChapters          Int?
  isSuggested            Boolean                 @default(false)
  tags                   ContentTag[]
  library                UserLibrary[]
  discordRecommendations DiscordRecommendation[]
  favourites             Favourite[]
  subredditRecommendations SubredditRecommendation[]
  reviews                Review[]
  activities             Activity[]

  parentId               Int?
  parent                 Content?                @relation("ContentToContent", fields: [parentId], references: [id])
  children               Content[]               @relation("ContentToContent")

  @@unique([source, externalId])
  @@index([createdAt])
  @@index([category, createdAt])
  @@index([rating])
}

model Tag {
  id        Int          @id @default(autoincrement())
  type      String
  name      String
  createdAt DateTime     @default(now())
  contents  ContentTag[]

  @@unique([type, name])
}

model ContentTag {
  contentId Int
  tagId     Int
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
  @@index([tagId, contentId])
}

model UserPreference {
  userId             Int
  preferenceOptionId Int
  createdAt          DateTime         @default(now())
  PreferenceOption   PreferenceOption @relation(fields: [preferenceOptionId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, preferenceOptionId])
}

model PreferenceOption {
  id             Int              @id @default(autoincrement())
  type           String
  value          String
  createdAt      DateTime         @default(now())
  UserPreference UserPreference[]

  @@unique([type, value])
}

model UserLibrary {
  id        Int      @id @default(autoincrement())
  userId    Int
  contentId Int
  status    String
  rating    Int?
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId, status])
  @@index([userId, updatedAt])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  contentId Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}

model UserAchievement {
  id         Int      @id @default(autoincrement())
  userId     Int
  key        String
  unlockedAt DateTime @default(now())
  pinned     Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model DiscordRecommendation {
  id         Int      @id @default(autoincrement())
  userId     Int
  contentId  Int
  inviteLink String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}

model Event {
  id            Int       @id @default(autoincrement())
  title         String
  description   String
  type          String
  startDate     DateTime
  endDate       DateTime?
  discordServer String?
  createdBy     Int
  status        String    @default("UPCOMING")
  approval      String    @default("PENDING")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  host User @relation(fields: [createdBy], references: [id], onDelete: Cascade)
}

model Favourite {
  id        Int      @id @default(autoincrement())
  userId    Int
  contentId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId, createdAt])
}

model SubredditRecommendation {
  id        Int      @id @default(autoincrement())
  userId    Int
  contentId Int
  subreddit String
  status    String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}

// Activity feed entries — logged whenever a user watches/favourites/rates/reviews something.
model Activity {
  id        Int      @id @default(autoincrement())
  userId    Int
  contentId Int?
  type      String   // "WATCHING" | "COMPLETED" | "PLANNING" | "FAVOURITED" | "RATED" | "REVIEWED"
  rating    Int?
  comment   String?
  createdAt DateTime @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content?           @relation(fields: [contentId], references: [id], onDelete: Cascade)
  reactions ActivityReaction[]
  comments  ActivityComment[]

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Simple one-directional "follow" relationship — no mutual social graph, just an add.
model Friendship {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// Reactions on Activity entries (e.g. LIKE, HEART, FIRE, CLAP, etc.)
model ActivityReaction {
  id         Int      @id @default(autoincrement())
  activityId Int
  userId     Int
  emoji      String
  createdAt  DateTime @default(now())

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId, emoji])
  @@index([activityId])
  @@index([userId])
}

// Comments on Activity entries
model ActivityComment {
  id         Int      @id @default(autoincrement())
  activityId Int
  userId     Int
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([activityId, createdAt])
  @@index([userId])
}
