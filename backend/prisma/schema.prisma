generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int                     @id @default(autoincrement())
  username               String                  @unique
  email                  String                  @unique
  passwordHash           String
  role                   String                  @default("User")
  bio                    String?
  avatarUrl              String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  preferences            UserPreference[]
  library                UserLibrary[]
  achievements           UserAchievement[]
  discordRecommendations DiscordRecommendation[]
  events                 Event[]
  favourites               Favourite[]
  subredditRecommendations SubredditRecommendation[]
  reviews                Review[]
}

model Content {
  id                     Int                     @id @default(autoincrement())
  title                  String
  category               String
  description            String
  discordLink            String?
  redditLink             String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  coverImage             String?
  externalId             String?
  externalUrl            String?
  rating                 Float?
  source                 String?
  status                 String?
  isSuggested            Boolean                 @default(false)
  tags                   ContentTag[]
  library                UserLibrary[]
  discordRecommendations DiscordRecommendation[]
  favourites             Favourite[]
  subredditRecommendations SubredditRecommendation[]
  reviews                Review[]

  parentId               Int?
  parent                 Content?                @relation("ContentToContent", fields: [parentId], references: [id])
  children               Content[]               @relation("ContentToContent")

  @@unique([source, externalId])
  @@index([createdAt])
  @@index([category, createdAt])
  @@index([rating])
}

model Tag {
  id        Int          @id @default(autoincrement())
  type      String
  name      String
  createdAt DateTime     @default(now())
  contents  ContentTag[]

  @@unique([type, name])
}

model ContentTag {
  contentId Int
  tagId     Int
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
  @@index([tagId, contentId])
}

model UserPreference {
  userId             Int
  preferenceOptionId Int
  createdAt          DateTime         @default(now())
  PreferenceOption   PreferenceOption @relation(fields: [preferenceOptionId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, preferenceOptionId])
}

model PreferenceOption {
  id             Int              @id @default(autoincrement())
  type           String
  value          String
  createdAt      DateTime         @default(now())
  UserPreference UserPreference[]

  @@unique([type, value])
}

model UserLibrary {
  id        Int      @id @default(autoincrement())
  userId    Int
  contentId Int
  status    String
  rating    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId, status])
  @@index([userId, updatedAt])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  contentId Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}

model UserAchievement {
  id         Int      @id @default(autoincrement())
  userId     Int
  key        String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model DiscordRecommendation {
  id         Int      @id @default(autoincrement())
  userId     Int
  contentId  Int
  inviteLink String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}

model Event {
  id            Int       @id @default(autoincrement())
  title         String
  description   String
  type          String
  startDate     DateTime
  endDate       DateTime?
  discordServer String?
  createdBy     Int
  status        String    @default("UPCOMING")
  approval      String    @default("PENDING")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  host User @relation(fields: [createdBy], references: [id], onDelete: Cascade)
}

model Favourite {
  id        Int      @id @default(autoincrement())
  userId    Int
  contentId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId, createdAt])
}

model SubredditRecommendation {
  id        Int      @id @default(autoincrement())
  userId    Int
  contentId Int
  subreddit String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}
